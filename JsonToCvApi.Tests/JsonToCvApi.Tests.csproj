<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonToCvApi\JsonToCvApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\JsonToCvApi\Templates\Slate\template.html" Link="Templates\Slate\template.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\JsonToCvApi\Templates\Slate\Fonts\*.woff2" Link="Templates\Slate\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\JsonToCvApi\Data\sample-cv.json" Link="Data\sample-cv.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
